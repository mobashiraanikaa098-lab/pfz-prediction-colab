   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Download ERA5 Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cdsapi\n",
    "\n",
    "def download_era5_monthly(year, month, output_dir=DATA_DIR):\n",
    "    \"\"\"Download monthly ERA5 data.\"\"\"\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    c = cdsapi.Client()\n",
    "    \n",
    "    outfile = os.path.join(output_dir, f\"era5_{year}_{month:02d}.nc\")\n",
    "    \n",
    "    if os.path.exists(outfile):\n",
    "        print(f\"Already exists: {outfile}\")\n",
    "        return outfile\n",
    "    \n",
    "    request = {\n",
    "        \"product_type\": \"reanalysis\",\n",
    "        \"variable\": [\n",
    "            \"sea_surface_temperature\",\n",
    "            \"10m_u_component_of_wind\",\n",
    "            \"10m_v_component_of_wind\",\n",
    "        ],\n",
    "        \"year\": f\"{year}\",\n",
    "        \"month\": f\"{month:02d}\",\n",
    "        \"day\": [f\"{d:02d}\" for d in range(1, 32)],\n",
    "        \"time\": [\"00:00\", \"06:00\", \"12:00\", \"18:00\"],\n",
    "        \"area\": [\n",
    "            TARGET_BOUNDS[\"lat_max\"],\n",
    "            TARGET_BOUNDS[\"lon_min\"],\n",
    "            TARGET_BOUNDS[\"lat_min\"],\n",
    "            TARGET_BOUNDS[\"lon_max\"],\n",
    "        ],\n",
    "        \"format\": \"netcdf\",\n",
    "    }\n",
    "    \n",
    "    print(f\"Downloading ERA5 {year}-{month:02d}...\")\n",
    "    c.retrieve(\"reanalysis-era5-single-levels\", request, outfile)\n",
    "    print(f\"✓ Saved: {outfile}\")\n",
    "    return outfile\n",
    "\n",
    "# Download all months from 2024-01 to 2026-09\n",
    "era5_files = []\n",
    "dates = pd.date_range(TRAIN_START, TRAIN_END, freq=\"MS\")\n",
    "\n",
    "for d in dates:\n",
    "    f = download_era5_monthly(d.year, d.month)\n",
    "    era5_files.append(f)\n",
    "    \n",
    "print(f\"\\n✓ Downloaded {len(era5_files)} ERA5 files\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Download Copernicus Marine Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def download_copernicus_data(start_date, end_date, output_dir=DATA_DIR):\n",
    "    \"\"\"Download Copernicus Marine BGC data.\"\"\"\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    \n",
    "    # Download BGC (biochemical) variables: chlorophyll, DO, salinity\n",
    "    datasets = [\n",
    "        {\n",
    "            \"id\": \"cmems_mod_glo_bgc_my_0.25_P1D-m\",\n",
    "            \"vars\": [\"chl\", \"o2\", \"so\"],  # chlorophyll, oxygen, salinity\n",
    "            \"name\": \"bgc\",\n",
    "        },\n",
    "        {\n",
    "            \"id\": \"cmems_mod_glo_phy_my_0.083deg_P1D-m\",\n",
    "            \"vars\": [\"uo\", \"vo\"],  # u and v current components\n",
    "            \"name\": \"currents\",\n",
    "        },\n",
    "    ]\n",
n",
    "    for ds in datasets:\n",
    "        output_subdir = os.path.join(output_dir, ds[\"name\"])\n",
    "        os.makedirs(output_subdir, exist_ok=True)\n",
    "        \n",
    "        print(f\"\\nDownloading {ds['name']} data...\")\n",
    "        cmd = [\n",
    "            \"copernicusmarine\",\n",
    "            \"subset\",\n",
    "            \"--dataset-id\", ds[\"id\"],\n",
    "            \"--variables\", *ds[\"vars\"],\n",
    "            \"--start-date\", start_date,\n",
    "            \"--end-date\", end_date,\n",
    "            \"--longitude-min\", str(TARGET_BOUNDS[\"lon_min\"]),\n",
    "            \"--longitude-max\", str(TARGET_BOUNDS[\"lon_max\"]),\n",
    "            \"--latitude-min\", str(TARGET_BOUNDS[\"lat_min\"]),\n",
    "            \"--latitude-max\", str(TARGET_BOUNDS[\"lat_max\"]),\n",
    "            \"--output-dir\", output_subdir,\n",
    "            \"--force-download\",\n",
    "        ]\n",
    "        \n",
    "        try:\n",
    "            result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)\n",
    "            if result.returncode == 0:\n",
    "                print(f\"✓ Downloaded {ds['name']}\")\n",
    "            else:\n",
    "                print(f\"✗ Error downloading {ds['name']}:\")\n",
    "                print(result.stderr)\n",
    "        except subprocess.TimeoutExpired:\n",
    "            print(f\"✗ Timeout downloading {ds['name']}\")\n",
    "        except Exception as e:\n",
    "            print(f\"✗ Error: {e}\")\n",
    "\n",
    "print(\"Starting Copernicus downloads...\")\n",
    "download_copernicus_data(TRAIN_START, TRAIN_END)\n",
    "print(\"\\n✓ Copernicus download attempt complete (may take 10-30 minutes depending on data size)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 8: Load and Preprocess Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_era5(era5_dir=DATA_DIR):\n",
    "    \"\"\"Load all ERA5 NetCDF files.\"\"\"\n",
    "    files = sorted([os.path.join(era5_dir, f) for f in os.listdir(era5_dir) if f.startswith(\"era5_\") and f.endswith(\".nc\")])\n",
    "    \n",
    "    if not files:\n",
    "        print(f\"No ERA5 files found in {era5_dir}\")\n",
    "        return None\n",
    "    \n",
    "    print(f\"Loading {len(files)} ERA5 files...\")\n",
    "    ds = xr.open_mfdataset(files, combine=\"by_coords\", decode_times=True, parallel=False)\n",
    "    \n",
    "    # Subset to target bounds\n",
    "    ds = ds.sel(\n",
    "        latitude=slice(TARGET_BOUNDS[\"lat_max\"], TARGET_BOUNDS[\"lat_min\"]),\n",
    "        longitude=slice(TARGET_BOUNDS[\"lon_min\"], TARGET_BOUNDS[\"lon_max\"])\n",
    "    )\n",
    "    \n",
    "    print(f\"✓ Loaded ERA5 data: {ds}\")\n",
    "    return ds\n",
    "\n",
    "def load_copernicus(copernicus_dir=DATA_DIR):\n",
    "    \"\"\"Load Copernicus NetCDF files.\"\"\"\n",
    "    datasets = {}\n",
    "    \n",
    "    for subdir in [\"bgc\", \"currents\"]:\n",
    "        full_path = os.path.join(copernicus_dir, subdir)\n",
    "        if not os.path.exists(full_path):\n",
    "            print(f\"Directory not found: {full_path}\")\n",
    "            continue\n",
    "        \n",
    "        files = [os.path.join(full_path, f) for f in os.listdir(full_path) if f.endswith(\".nc\")]\n",
    "        if files:\n",
    "            print(f\"Loading {len(files)} {subdir} files...\")\n",
    "            ds = xr.open_mfdataset(files, combine=\"by_coords\", decode_times=True, parallel=False)\n",
    "            datasets[subdir] = ds\n",
    "            print(f\"✓ Loaded {subdir}\")\n",
    "        else:\n",
    "            print(f\"No files found in {full_path}\")\n",
    "    \n",
    "    return datasets\n",
    "\n",
    "# Load data\n",
    "era5_ds = load_era5()\n",
    "copernicus_ds = load_copernicus()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 9: Feature Engineering for ML"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_thermal_front(sst):\n",
    "    \"\"\"Compute SST gradient magnitude (thermal front strength).\"\"\"\n",
    "    if sst is None:\n",
    "        return None\n",
    "    dlat = np.gradient(sst, axis=-2)\n",
    "    dlon = np.gradient(sst, axis=-1)\n",
    "    front = np.sqrt(dlat**2 + dlon**2)\n",
    "    return front\n",
    "\n",
    "def normalize_feature(arr):\n",
    "    \"\"\"Normalize feature to [-1, 1].\"\"\"\n",
    "    if np.isnan(arr).all():\n",
    "        return arr\n",
    "    arr = np.asarray(arr, dtype=float)\n",
    "    mean = np.nanmean(arr)\n",
    "    std = np.nanstd(arr)\n",
    "    if std > 0:\n",
    "        arr = (arr - mean) / std\n",
    "    return arr\n",
    "\n",
    "def build_feature_matrix(era5_ds, copernicus_ds):\n",
    "    \"\"\"Build feature matrix for ML training.\n",
    "    \n",
    "    Features:\n",
    "    - SST (sea surface temperature)\n",
    "    - SST gradient / thermal front strength\n",
    "    - Wind speed magnitude\n",
    "    - Chlorophyll concentration\n",
    "    - Dissolved oxygen\n",
    "    - Salinity\n",
    "    - Current speed magnitude\n",
    "    \"\"\"\n",
    "    \n",
    "    feature_dict = {}\n",
    "    time_list = []\n",
    "    \n",
    "    if era5_ds is None:\n",
    "        raise ValueError(\"ERA5 data not loaded\")\n",
    "    \n",
    "    # Process each time step\n",
    "    for t, time_val in enumerate(era5_ds.time.values):\n",
    "        sst = era5_ds[\"sea_surface_temperature\"].isel(time=t).values - 273.15  # K to C\n",
    "        u10 = era5_ds[\"10m_u_component_of_wind\"].isel(time=t).values\n",
    "        v10 = era5_ds[\"10m_v_component_of_wind\"].isel(time=t).values\n",
    "        \n",
    "        wind_speed = np.sqrt(u10**2 + v10**2)\n",
    "        front = compute_thermal_front(sst)\n",
    "        \n",
    "        # Initialize feature for this time step\n",
    "        if t == 0:\n",
    "            nlat, nlon = sst.shape\n",
    "            feature_dict[\"sst\"] = []\n",
    "            feature_dict[\"front\"] = []\n",
    "            feature_dict[\"wind_speed\"] = []\n",
    "            feature_dict[\"chl\"] = []\n",
    "            feature_dict[\"do\"] = []\n",
    "            feature_dict[\"sal\"] = []\n",
    "            feature_dict[\"current_speed\"] = []\n",
    "        \n",
    "        feature_dict[\"sst\"].append(sst.flatten())\n",
    "        feature_dict[\"front\"].append(front.flatten())\n",
    "        feature_dict[\"wind_speed\"].append(wind_speed.flatten())\n",
    "        \n",
    "        # Copernicus data (if available)\n",
    "        chl = np.zeros_like(sst)\n",
    "        do = np.zeros_like(sst)\n",
    "        sal = np.zeros_like(sst)\n",
    "        current_speed = wind_speed.copy()\n",
    "        \n",
    "        if \"bgc\" in copernicus_ds:\n",
    "            bgc = copernicus_ds[\"bgc\"]\n",
    "            if \"chl\" in bgc and t < len(bgc.time):\n",
    "                chl = bgc[\"chl\"].isel(time=t).values\n",
    "            if \"o2\" in bgc and t < len(bgc.time):\n",
    "                do = bgc[\"o2\"].isel(time=t).values\n",
    "            if \"so\" in bgc and t < len(bgc.time):\n",
    "                sal = bgc[\"so\"].isel(time=t).values\n",
    "        \n",
    "        if \"currents\" in copernicus_ds:\n",
    "            curr = copernicus_ds[\"currents\"]\n",
    "            if \"uo\" in curr and \"vo\" in curr and t < len(curr.time):\n",
    "                uo = curr[\"uo\"].isel(time=t).values\n",
    "                vo = curr[\"vo\"].isel(time=t).values\n",
    "                current_speed = np.sqrt(uo**2 + vo**2)\n",
    "        \n",
    "        feature_dict[\"chl\"].append(chl.flatten())\n",
    "        feature_dict[\"do\"].append(do.flatten())\n",
    "        feature_dict[\"sal\"].append(sal.flatten())\n",
    "        feature_dict[\"current_speed\"].append(current_speed.flatten())\n",
    "        \n",
    "        time_list.append(time_val)\n",
    "    \n",
    "    # Stack into time x features matrix\n",
    "    X = np.column_stack([\n",
    "        np.vstack(feature_dict[\"sst\"]),\n",
    "        np.vstack(feature_dict[\"front\"]),\n",
    "        np.vstack(feature_dict[\"wind_speed\"]),\n",
    "        np.vstack(feature_dict[\"chl\"]),\n",
    "        np.vstack(feature_dict[\"do\"]),\n",
    "        np.vstack(feature_dict[\"sal\"]),\n",
    "        np.vstack(feature_dict[\"current_speed\"]),\n",
    "    ])\n",
    "    \n",
    "    print(f\"✓ Built feature matrix: shape = {X.shape}\")\n",
    "    print(f\"  Features: SST, Thermal Front, Wind, Chl-a, DO, Salinity, Current Speed\")\n",
    "    \n",
    "    return X, time_list, feature_dict, (nlat, nlon)\n",
    "\n",
    "# Build features\n",
    "print(\"Building feature matrix...\")\n",
    "X, time_list, features_raw, spatial_shape = build_feature_matrix(era5_ds, copernicus_ds)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 10: Create PFZ Labels (Historical Rule-Based)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_pfz_labels(features_dict):\n",
    "    \"\"\"Create binary PFZ labels based on environmental conditions.\n",
    "    \n",
    "    PFZ criteria (rule-based from fisheries knowledge):\n",
    "    - Strong thermal front (gradient > 70th percentile)\n",
    "    - High chlorophyll (> 50th percentile)\n",
    "    - Moderate to high oxygen (> 30th percentile)\n",
    "    - High current speed (> 50th percentile)\n",
    "    \n",
    "    Returns:\n",
    "    - y: binary labels (1 = PFZ, 0 = No PFZ)\n",
    "    \"\"\"\n",
    "    \n",
    "    sst = np.vstack(features_dict[\"sst\"])\n",
    "    front = np.vstack(features_dict[\"front\"])\n",
    "    chl = np.vstack(features_dict[\"chl\"])\n",
    "    do = np.vstack(features_dict[\"do\"])\n",
    "    current = np.vstack(features_dict[\"current_speed\"])\n",
    "    \n",
    "    # Define thresholds\n",
    "    front_thresh = np.nanpercentile(front, 70)\n",
    "    chl_thresh = np.nanpercentile(chl, 50)\n",
    "    do_thresh = np.nanpercentile(do, 30)\n",
    "    current_thresh = np.nanpercentile(current, 50)\n",
    "    \n",
    "    # Create label: PFZ = strong front AND high chl AND decent O2 AND good current\n",
    "    y = (\n",
    "        (front > front_thresh) &\n",
    "        (chl > chl_thresh) &\n",
    "        (do > do_thresh) &\n",
    "        (current > current_thresh)\n",
    "    ).astype(int)\n",
    "    \n",
    "    print(f\"PFZ Label Statistics:\")\n",
    "    print(f\"  Total pixels: {y.size}\")\n",
    "    print(f\"  PFZ pixels (1): {(y == 1).sum()}\")\n",
    "    print(f\"  No-PFZ pixels (0): {(y == 0).sum()}\")\n",
    "    print(f\"  PFZ prevalence: {(y == 1).sum() / y.size * 100:.1f}%\")\n",
    "    \n",
    "    return y\n",
    "\n",
    "y = create_pfz_labels(features_raw)\n",
    "print(f\"✓ Created {y.shape[0]} labeled training samples\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 11: Train ML Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Remove NaN values\n",
    "mask = ~np.isnan(X).any(axis=1)\n",
    "X_clean = X[mask]\n",
    "y_clean = y[mask]\n",
    "\n",
    "print(f\"Data after NaN removal: {X_clean.shape}\")\n",
    "print(f\"PFZ class distribution: {np.bincount(y_clean)}\")\n",
    "\n",
    "# Train-test split\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_clean, y_clean, test_size=0.2, random_state=42)\n",
    "\n",
    "# Scale features\n",
    "scaler = StandardScaler()\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "print(f\"Training set: {X_train_scaled.shape}\")\n",
    "print(f\"Test set: {X_test_scaled.shape}\")\n",
    "\n",
    "# Train Random Forest\n",
    "print(\"\\nTraining Random Forest classifier...\")\n",
    "rf_model = RandomForestClassifier(n_estimators=100, max_depth=20, n_jobs=-1, random_state=42)\n",
    "rf_model.fit(X_train_scaled, y_train)\n",
    "rf_score = rf_model.score(X_test_scaled, y_test)\n",
    "print(f\"✓ Random Forest test accuracy: {rf_score:.4f}\")\n",
    "\n",
    "# Train Gradient Boosting\n",
    "print(\"\\nTraining Gradient Boosting classifier...\")\n",
    "gb_model = GradientBoostingClassifier(n_estimators=100, max_depth=5, learning_rate=0.1, random_state=42)\n",
    "gb_model.fit(X_train_scaled, y_train)\n",
    "gb_score = gb_model.score(X_test_scaled, y_test)\n",
    "print(f\"✓ Gradient Boosting test accuracy: {gb_score:.4f}\")\n",
    "\n",
    "# Save models\n",
    "joblib.dump(rf_model, os.path.join(OUTPUT_DIR, \"rf_model.pkl\"))\n",
    "joblib.dump(gb_model, os.path.join(OUTPUT_DIR, \"gb_model.pkl\"))\n",
    "joblib.dump(scaler, os.path.join(OUTPUT_DIR, \"scaler.pkl\"))\n",
    "print(f\"\\n✓ Models saved to {OUTPUT_DIR}\")"
   ]
  },
