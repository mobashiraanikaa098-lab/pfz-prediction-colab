    "def plot_pfz_prediction(date_str, pred, output_dir=OUTPUT_DIR):\n",
    "    \"\"\"Plot comprehensive PFZ map.\"\"\"\n",
    "    \n",
    "    fig = plt.figure(figsize=(16, 12), dpi=150)\n",
    "    \n",
    "    # Subplot 1: Ensemble Probability (main map)\n",
    "    ax1 = plt.subplot(2, 2, 1, projection=ccrs.PlateCarree())\n",
    "    ax1.set_extent([\n",
    "        TARGET_BOUNDS[\"lon_min\"], TARGET_BOUNDS[\"lon_max\"],\n",
    "        TARGET_BOUNDS[\"lat_min\"], TARGET_BOUNDS[\"lat_max\"]\n",
    "    ], crs=ccrs.PlateCarree())\n",
    "    \n",
    "    prob = pred[\"ensemble_prob\"]\n",
    "    lat = np.linspace(TARGET_BOUNDS[\"lat_min\"], TARGET_BOUNDS[\"lat_max\"], prob.shape[0])\n",
    "    lon = np.linspace(TARGET_BOUNDS[\"lon_min\"], TARGET_BOUNDS[\"lon_max\"], prob.shape[1])\n",
    "    LON, LAT = np.meshgrid(lon, lat)\n",
    "    \n",
    "    cf = ax1.contourf(LON, LAT, prob, levels=np.linspace(0, 1, 11), cmap=\"RdYlGn\", transform=ccrs.PlateCarree())\n",
    "    cbar = plt.colorbar(cf, ax=ax1, orientation=\"vertical\", pad=0.05, shrink=0.8)\n",
    "    cbar.set_label(\"PFZ Probability\")\n",
    "    \n",
    "    # Thermal fronts overlay\n",
    "    sst = pred[\"data\"][\"sst\"]\n",
    "    front = compute_thermal_front(sst)\n",
    "    front_levels = np.linspace(np.nanpercentile(front, 60), np.nanpercentile(front, 99), 5)\n",
    "    ax1.contour(LON, LAT, front, levels=front_levels, colors=\"black\", linewidths=1.0, alpha=0.6, transform=ccrs.PlateCarree())\n",
    "    \n",
    "    ax1.add_feature(cfeature.coastline, linewidth=0.8, edgecolor=\"black\")\n",
    "    ax1.add_feature(cfeature.land, facecolor=\"lightgray\", alpha=0.5)\n",
    "    ax1.gridlines(draw_labels=True, linestyle=\"--\", alpha=0.3)\n",
    "    ax1.set_title(f\"PFZ Ensemble Probability - {date_str}\", fontsize=12, fontweight=\"bold\")\n",
    "    \n",
    "    # Subplot 2: Thermal Front Strength\n",
    "    ax2 = plt.subplot(2, 2, 2, projection=ccrs.PlateCarree())\n",
    "    ax2.set_extent([\n",
    "        TARGET_BOUNDS[\"lon_min\"], TARGET_BOUNDS[\"lon_max\"],\n",
    "        TARGET_BOUNDS[\"lat_min\"], TARGET_BOUNDS[\"lat_max\"]\n",
    "    ], crs=ccrs.PlateCarree())\n",
    "    \n",
    "    cf2 = ax2.contourf(LON, LAT, front, levels=20, cmap=\"hot\", transform=ccrs.PlateCarree())\n",
    "    cbar2 = plt.colorbar(cf2, ax=ax2, orientation=\"vertical\", pad=0.05, shrink=0.8)\n",
    "    cbar2.set_label(\"SST Gradient (°C/cell)\")\n",
    "    ax2.add_feature(cfeature.coastline, linewidth=0.8, edgecolor=\"black\")\n",
    "    ax2.gridlines(draw_labels=True, linestyle=\"--\", alpha=0.3)\n",
    "    ax2.set_title(f\"Thermal Front Strength - {date_str}\", fontsize=12, fontweight=\"bold\")\n",
    "    \n",
    "    # Subplot 3: Wind + Current Vectors\n",
    "    ax3 = plt.subplot(2, 2, 3, projection=ccrs.PlateCarree())\n",
    "    ax3.set_extent([\n",
    "        TARGET_BOUNDS[\"lon_min\"], TARGET_BOUNDS[\"lon_max\"],\n",
    "        TARGET_BOUNDS[\"lat_min\"], TARGET_BOUNDS[\"lat_max\"]\n",
    "    ], crs=ccrs.PlateCarree())\n",
    "    \n",
    "    sst_smooth = gaussian_filter(sst, sigma=1)\n",
    "    cf3 = ax3.contourf(LON, LAT, sst_smooth, levels=15, cmap=\"coolwarm\", alpha=0.6, transform=ccrs.PlateCarree())\n",
    "    cbar3 = plt.colorbar(cf3, ax=ax3, orientation=\"vertical\", pad=0.05, shrink=0.8)\n",
    "    cbar3.set_label(\"SST (°C)\")\n",
    "    \n",
    "    u10 = pred[\"data\"][\"u10\"]\n",
    "    v10 = pred[\"data\"][\"v10\"]\n",
    "    step = max(1, pred[\"data\"][\"shape\"][0] // 15)  # Sample arrows\n",
    "    ax3.quiver(LON[::step, ::step], LAT[::step, ::step], u10[::step, ::step], v10[::step, ::step],\n",
    "               scale=200, width=0.003, color=\"navy\", alpha=0.7, transform=ccrs.PlateCarree())\n",
    "    \n",
    "    ax3.add_feature(cfeature.coastline, linewidth=0.8, edgecolor=\"black\")\n",
    "    ax3.gridlines(draw_labels=True, linestyle=\"--\", alpha=0.3)\n",
    "    ax3.set_title(f\"SST + Wind/Current - {date_str}\", fontsize=12, fontweight=\"bold\")\n",
    "    \n",
    "    # Subplot 4: Chlorophyll Concentration\n",
