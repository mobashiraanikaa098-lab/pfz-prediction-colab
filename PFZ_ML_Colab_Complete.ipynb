   "source": [
    "## Step 13: Prepare Prediction Data (Oct 4-5, 2026)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_features_for_date(era5_ds, copernicus_ds, target_date):\n",
    "    \"\"\"Extract features for a specific date.\"\"\"\n",
    "    \n",
    "    ds_day = era5_ds.sel(time=target_date)\n",
    "    \n",
    "    sst = ds_day[\"sea_surface_temperature\"].values - 273.15\n",
    "    u10 = ds_day[\"10m_u_component_of_wind\"].values\n",
    "    v10 = ds_day[\"10m_v_component_of_wind\"].values\n",
    "    \n",
    "    wind_speed = np.sqrt(u10**2 + v10**2)\n",
    "    front = compute_thermal_front(sst)\n",
    "    \n",
    "    # Copernicus variables\n",
    "    chl = np.zeros_like(sst)\n",
    "    do = np.zeros_like(sst)\n",
    "    sal = np.zeros_like(sst)\n",
    "    current_speed = wind_speed.copy()\n",
    "    \n",
    "    if \"bgc\" in copernicus_ds and \"time\" in copernicus_ds[\"bgc\"]:\n",
    "        bgc = copernicus_ds[\"bgc\"].sel(time=target_date, method=\"nearest\")\n",
    "        if \"chl\" in bgc:\n",
    "            chl = bgc[\"chl\"].values\n",
    "        if \"o2\" in bgc:\n",
    "            do = bgc[\"o2\"].values\n",
    "        if \"so\" in bgc:\n",
    "            sal = bgc[\"so\"].values\n",
    "    \n",
    "    if \"currents\" in copernicus_ds and \"time\" in copernicus_ds[\"currents\"]:\n",
    "        curr = copernicus_ds[\"currents\"].sel(time=target_date, method=\"nearest\")\n",
    "        if \"uo\" in curr and \"vo\" in curr:\n",
    "            uo = curr[\"uo\"].values\n",
    "            vo = curr[\"vo\"].values\n",
    "            current_speed = np.sqrt(uo**2 + vo**2)\n",
    "    \n",
    "    # Build feature matrix\n",
    "    nlat, nlon = sst.shape\n",
    "    X_day = np.column_stack([\n",
    "        sst.flatten(),\n",
    "        front.flatten(),\n",
    "        wind_speed.flatten(),\n",
    "        chl.flatten(),\n",
    "        do.flatten(),\n",
    "        sal.flatten(),\n",
    "        current_speed.flatten(),\n",
    "    ])\n",
    "    \n",
    "    return X_day, sst, u10, v10, chl, do, sal, current_speed, nlat, nlon\n",
    "\n",
    "print(\"Extracting features for prediction dates...\")\n",
    "pred_data = {}\n",
    "\n",
    "for date_str in PREDICT_DATES:\n",
    "    try:\n",
    "        X_date, sst, u10, v10, chl, do, sal, curr, nlat, nlon = extract_features_for_date(\n",
    "            era5_ds, copernicus_ds, date_str\n",
    "        )\n",
    "        \n",
    "        # Handle NaN values\n",
    "        X_date_clean = np.nan_to_num(X_date, nan=0.0)\n",
    "        X_date_scaled = scaler.transform(X_date_clean)\n",
    "        \n",
    "        pred_data[date_str] = {\n",
    "            \"X_scaled\": X_date_scaled,\n",
    "            \"sst\": sst,\n",
    "            \"u10\": u10,\n",
    "            \"v10\": v10,\n",
    "            \"chl\": chl,\n",
    "            \"do\": do,\n",
    "            \"sal\": sal,\n",
    "            \"current\": curr,\n",
    "            \"shape\": (nlat, nlon),\n",
    "        }\n",
    "        print(f\"✓ Extracted features for {date_str}\")\n",
    "    except Exception as e:\n",
    "        print(f\"✗ Error for {date_str}: {e}\")\n",
    "\n",
    "print(f\"\\n✓ Prepared prediction data for {len(pred_data)} dates\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 14: Make PFZ Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Make predictions using both models\n",
    "predictions = {}\n",
    "\n",
    "for date_str, data in pred_data.items():\n",
    "    X_scaled = data[\"X_scaled\"]\n",
    "    nlat, nlon = data[\"shape\"]\n",
    "    \n",
    "    # Predictions from both models\n",
    "    y_rf = rf_model.predict(X_scaled).reshape(nlat, nlon)\n",
    "    y_gb = gb_model.predict(X_scaled).reshape(nlat, nlon)\n",
    "    \n",
    "    # Probability predictions (average of both models)\n",
    "    prob_rf = rf_model.predict_proba(X_scaled)[:, 1].reshape(nlat, nlon)\n",
    "    prob_gb = gb_model.predict_proba(X_scaled)[:, 1].reshape(nlat, nlon)\n",
    "    prob_ensemble = (prob_rf + prob_gb) / 2.0\n",
    "    \n",
    "    predictions[date_str] = {\n",
    "        \"rf_class\": y_rf,\n",
    "        \"gb_class\": y_gb,\n",
    "        \"ensemble_prob\": prob_ensemble,\n",
    "        \"data\": data,\n",
    "    }\n",
    "    \n",
    "    print(f\"{date_str}:\")\n",
    "    print(f\"  RF PFZ pixels: {(y_rf == 1).sum()}\")\n",
    "    print(f\"  GB PFZ pixels: {(y_gb == 1).sum()}\")\n",
    "    print(f\"  Mean PFZ probability: {prob_ensemble.mean():.3f}\")\n",
    "\n",
    "print(\"\\n✓ PFZ predictions complete\")"
   ]
  },
